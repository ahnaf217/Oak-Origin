@model Address
@{
    ViewData["Title"] = "Checkout";
    List<Address> addresses = ViewBag.Addresses;
    var cartItems = ViewBag.CartItems as List<Cart>;
    decimal subTotal = 0;
    foreach (var item in cartItems)
    {
        subTotal += (item.Product.Price * item.Qty);
    }
}

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="author" content="Untree.co">
    <link rel="shortcut icon" href="@Url.Content("~/favicon.png")">
    <meta name="description" content="" />
    <meta name="keywords" content="bootstrap, bootstrap4" />

    <!-- Bootstrap CSS -->

    <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="@Url.Content("~/css/tiny-slider.css")" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

</head>



<div class="container my-5">
    <div class="row">
        <div class="col-lg-7">
            <h3>Select a Delivery Address</h3>
            @if (addresses != null && addresses.Any())
            {
                <div class="row">
                    @foreach (var address in addresses)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">@address.AddressLine</h5>
                                    <p class="card-text">@address.City, @address.State - @address.PinCode</p>
                                    <form asp-controller="Checkout" asp-action="Confirm" method="post">
                                        <input type="hidden" name="addressId" value="@address.Id" />
                                        <div class="form-group mb-3">
                                            <label for="storeCreditCode_@address.Id">Store Credit Code</label>
                                            <input type="text" name="storeCreditCode" id="storeCreditCode_@address.Id" class="form-control" placeholder="Enter code (optional)" />
                                        </div>
                                        <a asp-controller="Checkout" asp-action="Confirm" asp-route-addressId="@address.Id" class="btn btn-primary">Deliver Here</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    You have no saved addresses. Please add a new one below.
                </div>
            }

            <hr class="my-4" />

            <h3>Or Add a New Address</h3>
            <form asp-action="Index" method="post" class="mt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="AddressLine" class="control-label"></label>
                    <input asp-for="AddressLine" class="form-control" />
                    <span asp-validation-for="AddressLine" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="City" class="control-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="State" class="control-label"></label>
                    <input asp-for="State" class="form-control" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PinCode" class="control-label"></label>
                    <input asp-for="PinCode" class="form-control" />
                    <span asp-validation-for="PinCode" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <button type="submit" class="btn btn-secondary">Save New Address</button>
                </div>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="p-4 border rounded">
                <h4 class="mb-3">Order Summary</h4>
                <ul class="list-unstyled">
                    @foreach (var item in cartItems)
                    {
                        <li class="d-flex justify-content-between mb-2">
                            <span>@item.Product.Name (x @item.Qty)</span>
                            <span>$@(item.Product.Price* item.Qty)</span>
                        </li>
                    }
                    <li class="d-flex justify-content-between font-weight-bold mt-3 border-top pt-3">
                        <span>Subtotal</span>
                        <span>$@subTotal</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>