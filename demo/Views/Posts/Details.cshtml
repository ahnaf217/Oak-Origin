@model demo.Models.Post
@using System.Text.RegularExpressions

<div class="container">
    <h1>@Model.Title</h1>
    <p><strong>Category:</strong> @Model.Category?.Name</p>
    <img src="@Model.CoverImageUrl" class="img-fluid mb-3" alt="@Model.Title">
    <p>@Model.Content</p>
    <p><small>Published on: @Model.PublishedAt.ToShortDateString()</small></p>
</div>
