@using System.Text.RegularExpressions
@model demo.Models.Post
@{
    ViewData["Title"] = Model.Title;
    var related = ViewBag.Related as List<demo.Models.Post> ?? new();
}
@section Styles {
    <link rel="stylesheet" href="~/css/Blog.css" />
}

<section class="py-5" style="background:var(--cream);">
    <div class="container">
        <div class="row">
            <!-- Content -->
            <div class="col-lg-8">
                <img src="@Model.CoverImageUrl" alt="@Model.Title" class="img-fluid mb-4 card-radius" />
                <h1 class="fw-bold text-brown">@Model.Title</h1>
                <p class="text-muted mb-3">
                    <span class="badge badge-gold">@Model.PublishedAt.ToString("dd MMM yyyy")</span>
                    &nbsp;•&nbsp; <strong style="color:var(--saddle)">@Model.Category?.Name</strong>
                    &nbsp;•&nbsp; <span>Estimated Reading Time: @((Model.Content.Split(' ').Length / 200) + 1) min</span>
                </p>
                <article class="bg-white p-4 card-radius shadow-sm mb-5">
                    @Html.Raw(Model.Content)

                    
                    <h2 class="mt-4 text-brown">Additional Information</h2>
                    <p>
                        This blog post dives deep into the topic, providing insights and actionable tips.
                        Whether you're a beginner or an expert, there's something here for everyone.
                    </p>
                    <p>
                        Stay tuned for more updates and related articles. Don't forget to share your thoughts in the comments section below!
                    </p>
                </article>

                <div class="mt-5">
                    <h4 class="text-brown">Related Posts</h4>
                    <div id="relatedPostsCarousel" class="carousel slide" data-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < related.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <div class="d-flex">
                                        <img src="@related[i].CoverImageUrl" alt="@related[i].Title" class="img-fluid" style="width: 100px; height: 100px; object-fit: cover;" />
                                        <div class="ms-3">
                                            <h5><a href="@Url.Action("Details", "Blog", new { slug = related[i].Slug })">@related[i].Title</a></h5>
                                            <p class="text-muted">@related[i].PublishedAt.ToString("dd MMM yyyy")</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <a class="carousel-control-prev" href="#relatedPostsCarousel" role="button" data-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="sr-only">Previous</span>
                        </a>
                        <a class="carousel-control-next" href="#relatedPostsCarousel" role="button" data-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="sr-only">Next</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="p-4 mb-4 section-soft card-radius shadow-sm">
                    <h5 class="text-brown mb-2">Table of Contents</h5>
                    <ul>
                        @foreach (var heading in Regex.Matches(Model.Content, @"<h[1-6]>(.*?)<\/h[1-6]>").Cast<Match>())
                        {
                            <li><a href="#@heading.Groups[1].Value.Replace(" ", "-")">@Html.Raw(heading.Groups[1].Value)</a></li>
                        }
                    </ul>
                </div>

                <div class="p-4 section-soft card-radius shadow-sm">
                    <h5 class="text-brown mb-2">Share This Post</h5>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-primary" href="https://www.facebook.com/sharer/sharer.php?u=@Url.Action("Details", "Blog", new { slug = Model.Slug }, Context.Request.Scheme)" target="_blank">Facebook</a>
                        <a class="btn btn-sm btn-info" href="https://twitter.com/intent/tweet?url=@Url.Action("Details", "Blog", new { slug = Model.Slug }, Context.Request.Scheme)&text=@Model.Title" target="_blank">Twitter</a>
                        <a class="btn btn-sm btn-danger" href="https://pinterest.com/pin/create/button/?url=@Url.Action("Details", "Blog", new { slug = Model.Slug }, Context.Request.Scheme)&description=@Model.Title" target="_blank">Pinterest</a>
                    </div>
                </div>
            </div>
            <div class="mt-5">
                <h4 class="text-brown">Comments</h4>
                <div class="bg-white p-4 card-radius shadow-sm">
                    @if (ViewBag.Comments != null && ViewBag.Comments.Any())
                    {
                        @foreach (var comment in ViewBag.Comments)
                        {
                            <div class="mb-3">
                                <strong>@comment.Author</strong>
                                <p class="mb-1">@comment.Content</p>
                                <small class="text-muted">@comment.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</small>
                            </div>
                            <hr />
                        }
                    }
                    else
                    {
                        <p class="text-muted">No comments yet. Be the first to comment!</p>
                    }
                </div>

                <div class="mt-4">
                    <h5 class="text-brown">Add a Comment</h5>
                    <form asp-action="AddComment" method="post">
                        <input type="hidden" name="PostId" value="@Model.Id" />
                        <div class="form-group">
                            <label for="Author">Name</label>
                            <input type="text" name="Author" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label for="Content">Comment</label>
                            <textarea name="Content" class="form-control" rows="4" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-brown">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
