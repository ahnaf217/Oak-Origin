@model demo.Models.Post

<div class="card card-radius card-bg shadow-sm border-0 h-100 blog-card">
    <img src="@Model.CoverImageUrl" alt="@Model.Title" class="card-img-top blog-img" />
    <div class="card-body d-flex flex-column">
        <span class="badge badge-gold mb-2">@Model.PublishedAt.ToString("dd MMM yyyy")</span>
        <h5 class=" fw-bold text-brown">@Model.Title</h5>
        <p class="mb-3 text-muted">@Model.Excerpt</p>
        <a class="btn btn-sm btn-brown" href="@Url.Action("Details", "Blog", new { slug = Model.Slug })">Read More</a>
    </div>
</div>
