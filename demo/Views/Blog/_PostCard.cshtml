@model demo.Models.Post

<div class="card card-radius card-bg shadow-sm border-0 h-100">
    <img src="@Model.CoverImageUrl" alt="@Model.Title" class="card-img-top" />
    <div class="card-body">
        <span class="badge badge-gold">@Model.PublishedAt.ToString("dd MMM yyyy")</span>
        <h5 class="mt-3 fw-bold text-brown">@Model.Title</h5>
        <p class="mb-3">@Model.Excerpt</p>
        <a class="btn btn-sm btn-brown" href="@Url.Action("Details", "Blog", new { slug = Model.Slug })">Read More</a>
    </div>
</div>
