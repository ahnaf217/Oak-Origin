@model List<demo.Models.Order>

@{
    ViewData["Title"] = "Recycling";
}

<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title mb-4">My Orders & Recycling</h2>

            @if (Model.Any())
            {
                @foreach (var order in Model)
                {
                    <div class="mb-4">
                        <h4>Order #@order.Id - @order.CreatedAt.ToShortDateString()</h4>
                        <ul class="list-group">
                            @foreach (var orderProduct in order.OrderProducts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@orderProduct.Product.Name</h5>
                                        <p class="mb-0">Quantity: @orderProduct.Qty</p>
                                    </div>
                                    <a asp-controller="Recycling" asp-action="Request" asp-route-productId="@orderProduct.ProductId" class="btn btn-primary">
                                        Recycle This
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">You have no past orders to recycle.</div>
            }
        </div>
    </div>
</div>