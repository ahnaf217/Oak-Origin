    <main>
        <section class="hero" id="home">
            <div class="container">
                <div class="hero-content">
                    <h1>Transform Your Old Furniture into Something New</h1>
                    <p>Join thousands of eco-conscious individuals in giving furniture a second life through sustainable recycling and creative upcycling.</p>
                    <a asp-controller="Recycling" asp-action="Index" class="btn btn-primary" style="background-color: #f9bf29; border-color: #f9bf29; color: #2f2f2f;">Start Recycling</a>
                </div>
            </div>
        </section>

        <section class="process" id="process">
            <div class="container">
                <h2 class="section-title">How It Works</h2>
                <div class="process-grid">
                    <div class="process-card">
                        <div class="process-icon">♻️</div>
                        <h3>Assess & Sort</h3>
                        <p>Evaluate your furniture's condition and determine the best recycling path. We help you identify what can be donated, repurposed, or recycled.</p>
                    </div>
                    <div class="process-card">
                        <div class="process-icon">🔨</div>
                        <h3>Repurpose & Upcycle</h3>
                        <p>Transform old pieces into functional art. Our community shares creative ideas and step-by-step guides for amazing furniture makeovers.</p>
                    </div>
                    <div class="process-card">
                        <div class="process-icon">🌱</div>
                        <h3>Recycle Responsibly</h3>
                        <p>For items beyond repair, we connect you with certified recycling centers that properly process materials and minimize environmental impact.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="upcycling" id="ideas">
            <div class="container">
                <h2 class="section-title">Upcycling Inspiration</h2>
                <div class="ideas-grid">
                    <div class="idea-card">
                        <img src="@Url.Content("https://m.media-amazon.com/images/I/71yd5CblgBL.jpg")" alt="Dresser to Vanity" class="idea-image">
                        <div class="idea-content">
                            <h3>Dresser to Bathroom Vanity</h3>
                            <p>Transform an old dresser into a stunning bathroom vanity with some plumbing modifications and a fresh coat of paint.</p>
                        </div>
                    </div>
                    <div class="idea-card">
                        <img src="@Url.Content("https://media.diy.com/is/image/KingfisherDigital/4-tier-wooden-plant-stand-ladder~5025912167585_03c_MP?$MOB_PREV$&$width=600&$height=600")" alt="Ladder Bookshelf" class="idea-image">
                        <div class="idea-content">
                            <h3>Ladder Plant Shelf</h3>
                            <p>Give an old wooden ladder new life as a charming plant display shelf perfect for any room in your home.</p>
                        </div>
                    </div>
                    <div class="idea-card">
                        <img src="@Url.Content("https://odditymall.com/includes/content/upload/this-suitcase-cat-bunk-bed-is-a-brilliant-way-to-re-purpose-your-old-luggage-2969.jpg")" alt="Suitcase Pet Bed" class="idea-image">
                        <div class="idea-content">
                            <h3>Suitcase Pet Bed</h3>
                            <p>Convert a vintage suitcase into a cozy and stylish bed for your furry friends with some cushioning and creativity.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="stats">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat">
                        <span class="stat-number">12M</span>
                        <div class="stat-label">Tons of Furniture Saved</div>
                    </div>
                    <div class="stat">
                        <span class="stat-number">50K+</span>
                        <div class="stat-label">Active Community Members</div>
                    </div>
                    <div class="stat">
                        <span class="stat-number">85%</span>
                        <div class="stat-label">Waste Reduction Rate</div>
                    </div>
                    <div class="stat">
                        <span class="stat-number">200+</span>
                        <div class="stat-label">Partner Recycling Centers</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="community" id="community">
            <div class="container">
                <h2 class="section-title">Join Our Eco-Friendly Community</h2>
                <div class="testimonials">
                    <div class="testimonial">
                        <p class="testimonial-text">"I transformed my grandmother's old wardrobe into a beautiful entertainment center. The community's guidance was invaluable!"</p>
                        <div class="testimonial-author">- Sarah M.</div>
                    </div>
                    <div class="testimonial">
                        <p class="testimonial-text">"Thanks to EcoFurniture, I've diverted over 20 pieces from landfills and created amazing new furniture for my home."</p>
                        <div class="testimonial-author">- Mike R.</div>
                    </div>
                    <div class="testimonial">
                        <p class="testimonial-text">"The recycling network helped me properly dispose of furniture I couldn't repurpose. Great environmental impact!"</p>
                        <div class="testimonial-author">- Lisa K.</div>
                    </div>
                </div>
                <div style="margin-top: 2rem;">
                    <a href="#" class="btn">Join Our Community</a>
                </div>
            </div>
        </section>
    </main>

