@page
@model demo.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "My Account";
}
<link rel="stylesheet" href="~/css/Profile.css" />

<section class="profile-container">
    <h2 class="title">My Account</h2>
    <p class="breadcrumb">Home / My Account</p>
    <div class="profile-box">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <button class="active">Personal Information</button>
            <button>My Orders</button>
            <button>Manage Address</button>
            <button>Payment Method</button>
            <button>Password Manager</button>
            <button>Logout</button>
        </aside>
        <!-- Profile Form Area -->
        <div class="profile-form">
            <div class="profile-image">
                <img src="https://via.placeholder.com/100" alt="Profile" />
                <span class="edit-icon">✎</span>
                <input type="file" class="upload-image" />
            </div>
            <form method="post">
                <div class="form-group">
                    <label asp-for="UserProfile.FirstName">First Name *</label>
                    <input asp-for="UserProfile.FirstName" value="@Model.UserProfile?.FirstName" placeholder="Enter your first name" />
                </div>
                <div class="form-group">
                    <label asp-for="UserProfile.LastName">Last Name *</label>
                    <input asp-for="UserProfile.LastName" value="@Model.UserProfile?.LastName" placeholder="Enter your last name" />
                </div>
                <div class="form-group">
                    <label asp-for="UserProfile.Email">Email *</label>
                    <input asp-for="UserProfile.Email" value="@Model.UserProfile?.Email" placeholder="Enter your email" />
                </div>
                <div class="form-group">
                    <label asp-for="UserProfile.Phone">Phone *</label>
                    <input asp-for="UserProfile.Phone" value="@Model.UserProfile?.Phone" placeholder="Enter your phone number" />
                </div>
                <div class="form-group">
                    <label asp-for="UserProfile.Gender">Gender *</label>
                    <select asp-for="UserProfile.Gender">
                        <option value="">Select Gender</option>
                        <option value="Male" @(Model.UserProfile?.Gender == "Male" ? "selected" : "")>Male</option>
                        <option value="Female" @(Model.UserProfile?.Gender == "Female" ? "selected" : "")>Female</option>
                        <option value="Other" @(Model.UserProfile?.Gender == "Other" ? "selected" : "")>Other</option>
                    </select>
                </div>
                <button type="submit" class="update-btn">Update Changes</button>
            </form>
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <p class="success">@Model.Message</p>
            }
        </div>
    </div>
</section>
